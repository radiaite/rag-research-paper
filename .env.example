# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# All model calls in this benchmark go through Azure AI Foundry: embeddings and
# generation via Azure OpenAI, reranking via the Cohere serverless endpoint on
# the same resource. There is no direct-to-OpenAI or direct-to-Cohere path.

# Required — one key for the Azure AI Foundry resource
AZURE_API_KEY=

# Required — your resource endpoints, no trailing slash
# e.g. https://<your-resource>.services.ai.azure.com
AZURE_LLM_ENDPOINT=
AZURE_EMBED_ENDPOINT=

# Optional — Azure OpenAI API version (default below is what the paper used)
AZURE_API_VERSION=2024-12-01-preview

# Optional — logging
LOG_LEVEL=INFO
